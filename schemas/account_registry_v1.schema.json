{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.local/schemas/account_registry_v1.schema.json",
  "title":"SINERGY AccountRegistry v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","reporting_currency","accounts","account_registry_digest","generated_at","authority","ledger_mutation_authority","execution_authority","digest"],
  "properties":{
    "schema":{"const":"account.registry/v1"},
    "reporting_currency":{"type":"string","minLength":1},
    "accounts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["account_id","name","account_class","consolidation_class","valuation_class","immediate_liability","normal_side"],"properties":{
      "account_id":{"type":"string","minLength":1},
      "name":{"type":"string","minLength":1},
      "account_class":{"enum":["ASSET","LIABILITY","EQUITY","REVENUE","EXPENSE"]},
      "consolidation_class":{"enum":["EXTERNAL","INTRA_GROUP","MEMO"]},
      "valuation_class":{"type":"string","minLength":1},
      "immediate_liability":{"type":"boolean"},
      "normal_side":{"enum":["DEBIT","CREDIT"]}
    }}},
    "account_registry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "generated_at":{"type":"string","pattern":"^.+Z$"},
    "authority":{"const":"FINANCIAL_OS_ACCOUNT_REGISTRY"},
    "ledger_mutation_authority":{"const":"NONE"},
    "execution_authority":{"const":"NONE"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
