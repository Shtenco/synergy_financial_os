{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/maturity.snapshot/v1",
  "title": "SINERGY MaturitySnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "currency", "buckets", "lcr_1w", "lcr_4w", "lcr_8w"],
  "properties": {
    "schema": {"const": "maturity.snapshot/v1"},
    "as_of": {"type": "string", "format": "date-time"},
    "currency": {"type": "string", "minLength": 3, "maxLength": 16},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "funding_principal", "scheduled_unlock", "eligible_credit_capacity"],
        "properties": {
          "week": {"type": "integer", "minimum": 1, "maximum": 100},
          "funding_principal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "scheduled_unlock": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "eligible_credit_capacity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
        }
      }
    },
    "lcr_1w": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "lcr_4w": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "lcr_8w": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "funding_shortfall": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
