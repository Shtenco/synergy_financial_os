{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/maturity.snapshot/v1",
  "title": "SINERGY MaturitySnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "as_of_week",
    "currency",
    "total_open_principal",
    "immediately_callable_principal",
    "buckets"
  ],
  "properties": {
    "schema": {"const": "maturity.snapshot/v1"},
    "as_of": {"type": "string", "format": "date-time"},
    "as_of_week": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "minLength": 3, "maxLength": 16},
    "total_open_principal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "immediately_callable_principal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "scheduled_unlock",
          "cumulative_unlock",
          "duration_eligible_principal"
        ],
        "properties": {
          "week": {"type": "integer", "minimum": 1, "maximum": 100},
          "scheduled_unlock": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "cumulative_unlock": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "duration_eligible_principal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
        }
      }
    },
    "digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "metadata": {"type": "object"}
  }
}
