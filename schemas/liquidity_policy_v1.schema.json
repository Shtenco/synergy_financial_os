{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/liquidity.policy-v1.json","type":"object","additionalProperties":false,"required":["schema","policy_id","reporting_currency","as_of","horizons","distribution_outflow_treatment","generated_at","authority","authorization_authority","execution_authority","digest"],"properties":{"schema":{"const":"liquidity.policy/v1"},"policy_id":{"type":"string","minLength":1},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"as_of":{"type":"string"},"horizons":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["horizon_weeks","minimum_lcr","minimum_liquidity_surplus"],"properties":{"horizon_weeks":{"enum":[1,4,8]},"minimum_lcr":{"$ref":"#/$defs/decimal"},"minimum_liquidity_surplus":{"$ref":"#/$defs/decimal"}}}},"distribution_outflow_treatment":{"const":"IMMEDIATE_RESOURCE_REDUCTION_ALL_HORIZONS"},"generated_at":{"type":"string"},"authority":{"const":"FINANCIAL_OS_LIQUIDITY_POLICY"},"authorization_authority":{"const":"NONE"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}