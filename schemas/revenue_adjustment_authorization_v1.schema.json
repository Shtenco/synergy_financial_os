{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.local/schemas/revenue_adjustment_authorization_v1.schema.json",
  "title":"SINERGY RevenueAdjustmentAuthorization v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","authorization_id","target_period_id","project_id","reason","original_period_close_digest","original_accounting_close_digest","original_revenue_recognition_digest","original_ledger_event_digest","original_reporting_entry_digest","period_chain_proof_digest","customer_refund_amount","revenue_reduction_amount","refund_reserve_release_amount","tax_adjustment_amount","tax_treatment","external_fee_expense_amount","total_cash_outflow_amount","external_refund_evidence_digest","tax_evidence_digest","fee_evidence_digest","decision_evidence_digest","accounting_policy_digest","requirement_registry_digest","decision_authority","decided_at","effective_at","posting_authority","ai_authority","digest"],
  "properties":{
    "schema":{"const":"revenue.adjustment-authorization/v1"},
    "authorization_id":{"type":"string","minLength":1},
    "target_period_id":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "reason":{"enum":["REFUND","CHARGEBACK"]},
    "original_period_close_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "original_accounting_close_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "original_revenue_recognition_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "original_ledger_event_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "original_reporting_entry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "period_chain_proof_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "customer_refund_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "revenue_reduction_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "refund_reserve_release_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "tax_adjustment_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "tax_treatment":{"enum":["NONE","LIABILITY_RELEASE","RECOVERABLE_RECEIVABLE","NONRECOVERABLE_EXPENSE"]},
    "external_fee_expense_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "total_cash_outflow_amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "external_refund_evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tax_evidence_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "fee_evidence_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "decision_evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "accounting_policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "requirement_registry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decision_authority":{"enum":["HUMAN_COMMITTEE","MULTISIG_GOVERNANCE"]},
    "decided_at":{"type":"string","pattern":"^.+Z$"},
    "effective_at":{"type":"string","pattern":"^.+Z$"},
    "posting_authority":{"const":"SEPARATE_ADJUSTMENT_POSTING"},
    "ai_authority":{"const":"NONE"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
