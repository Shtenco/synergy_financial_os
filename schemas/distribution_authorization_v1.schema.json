{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.authorization-v1.json","type":"object","additionalProperties":false,"required":["schema","authorization_id","decision","decision_authority","distribution_plan_digest","distribution_capacity_replay_digest","liquidity_replay_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","approved_total_amount","requirement_registry_digest","approver_policy_digest","decision_evidence_digest","usage_policy","notes_digest","decided_at","expires_at","execution_authority","ai_authority","digest"],"properties":{"schema":{"const":"distribution.authorization/v1"},"authorization_id":{"type":"string","minLength":1},"decision":{"enum":["APPROVED","REJECTED"]},"decision_authority":{"enum":["HUMAN_COMMITTEE","MULTISIG_GOVERNANCE"]},"distribution_plan_digest":{"$ref":"#/$defs/hex64"},"distribution_capacity_replay_digest":{"$ref":"#/$defs/hex64"},"liquidity_replay_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"distribution_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"source_account_id":{"type":"string","minLength":1},"beneficiary_set_digest":{"$ref":"#/$defs/hex64"},"approved_total_amount":{"$ref":"#/$defs/nonnegative_decimal"},"requirement_registry_digest":{"$ref":"#/$defs/hex64"},"approver_policy_digest":{"$ref":"#/$defs/hex64"},"decision_evidence_digest":{"$ref":"#/$defs/hex64"},"usage_policy":{"const":"SINGLE_EXACT_BATCH"},"notes_digest":{"anyOf":[{"$ref":"#/$defs/hex64"},{"type":"null"}]},"decided_at":{"type":"string"},"expires_at":{"type":"string"},"execution_authority":{"const":"SEPARATE_METAPAY_BATCH_HANDOFF"},"ai_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nonnegative_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}