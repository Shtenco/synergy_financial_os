{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/chart-of-accounts/v1",
  "title": "SINERGY ChartOfAccounts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "accounting_perimeter", "accounts"],
  "properties": {
    "schema": {"const": "chart-of-accounts/v1"},
    "accounting_perimeter": {"type": "string", "minLength": 1},
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "kind", "normal_side", "consolidation_class", "valuation_class"],
        "properties": {
          "account": {"type": "string", "minLength": 1},
          "kind": {"enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"]},
          "normal_side": {"enum": ["DEBIT", "CREDIT"]},
          "consolidation_class": {"enum": ["EXTERNAL", "INTRA_GROUP", "MEMO"]},
          "valuation_class": {
            "enum": [
              "HARD_EXTERNAL_ASSET",
              "LIQUID_ELIGIBLE_ASSET",
              "ECONOMIC_ELIGIBLE_ASSET",
              "EXTERNAL_LIABILITY",
              "INTERNAL_CLAIM",
              "OWN_ISSUED_INSTRUMENT",
              "REVENUE_ACCOUNT",
              "EXPENSE_ACCOUNT",
              "EQUITY_ACCOUNT",
              "MEMO_ONLY"
            ]
          },
          "currency_policy": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
