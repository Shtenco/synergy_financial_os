{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.local/schemas/accounting_period_chain_proof_v1.schema.json",
  "title":"SINERGY AccountingPeriodChainProof v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","origin_period_close_digest","target_period_digest","target_opening_period_close_digest","chain_close_digests","generated_at","authority","execution_authority","digest"],
  "properties":{
    "schema":{"const":"accounting.period-chain-proof/v1"},
    "origin_period_close_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_period_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_opening_period_close_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "chain_close_digests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "generated_at":{"type":"string","pattern":"^.+Z$"},
    "authority":{"const":"PROVENANCE_ONLY"},
    "execution_authority":{"const":"NONE"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
