{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.system/schemas/economic.cycle-trace/v5",
  "title":"SINERGY EconomicCycleTrace v5",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "hex64":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "phase":{"enum":["FUNDING_STATE","PROJECT_PROPOSAL","PROJECT_SCREENING","CAPITAL_AUTHORIZATION","FUNDING_SETTLEMENT","PROJECT_EVIDENCE","REVENUE_SETTLEMENT","REVENUE_RECOGNITION","LEDGER_EVENT","ACCOUNTING_SNAPSHOT"]}
  },
  "required":["schema","cycle_id","household_or_funding_subject","project_id","status","complete","missing_phases","references","authority","profit_recognition","execution_authority","trust_finalization","digest"],
  "properties":{
    "schema":{"const":"economic.cycle-trace/v5"},
    "cycle_id":{"type":"string","minLength":1},
    "household_or_funding_subject":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "status":{"enum":["TRACE_PARTIAL","TRACE_COMPLETE"]},
    "complete":{"type":"boolean"},
    "missing_phases":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/phase"}},
    "references":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["phase","schema_id","digest","source_repository","subject_id","observed_at"],"properties":{"phase":{"$ref":"#/$defs/phase"},"schema_id":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/hex64"},"source_repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"subject_id":{"type":"string","minLength":1},"observed_at":{"type":"string","pattern":"Z$"}}}},
    "authority":{"const":"PROVENANCE_ONLY"},
    "profit_recognition":{"const":"REFERENCE_ONLY"},
    "execution_authority":{"const":"NONE"},
    "trust_finalization":{"const":"EXTERNAL_COMMITMENT_REQUIRED"},
    "digest":{"$ref":"#/$defs/hex64"}
  }
}
