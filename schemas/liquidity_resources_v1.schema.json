{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/liquidity.resources-v1.json","type":"object","additionalProperties":false,"required":["schema","measurement_id","statement_replay_digest","affected_period_id","as_of","reporting_currency","account_registry_digest","valuation_policy_digest","liquidity_policy_digest","horizons","generated_at","authority","accounting_authority","execution_authority","digest"],"properties":{"schema":{"const":"liquidity.resources/v1"},"measurement_id":{"type":"string","minLength":1},"statement_replay_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"as_of":{"type":"string"},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"account_registry_digest":{"$ref":"#/$defs/hex64"},"valuation_policy_digest":{"$ref":"#/$defs/hex64"},"liquidity_policy_digest":{"$ref":"#/$defs/hex64"},"horizons":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["horizon_weeks","liquid_resources","measurement_evidence_digest"],"properties":{"horizon_weeks":{"enum":[1,4,8]},"liquid_resources":{"$ref":"#/$defs/decimal"},"measurement_evidence_digest":{"$ref":"#/$defs/hex64"}}}},"generated_at":{"type":"string"},"authority":{"const":"FINANCIAL_OS_LIQUIDITY_MEASUREMENT"},"accounting_authority":{"const":"REFERENCE_ONLY"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}