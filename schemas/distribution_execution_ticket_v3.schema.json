{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"distribution.execution-ticket/v3",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","ticket_id","distribution_authorization_digest","distribution_plan_digest","distribution_available_capacity_schema","distribution_available_capacity_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","principal_total","external_fee_budget","total_authorized_outflow_ceiling","requirement_registry_digest","approver_policy_digest","verified_at","expires_at","handoff_policy","authority","payment_authority","execution_authority","ai_authority","usage_policy","fee_policy","digest"],
  "properties":{
    "schema":{"const":"distribution.execution-ticket/v3"},
    "ticket_id":{"type":"string","minLength":1},
    "distribution_authorization_digest":{"$ref":"#/$defs/hex64"},
    "distribution_plan_digest":{"$ref":"#/$defs/hex64"},
    "distribution_available_capacity_schema":{"const":"distribution.available-capacity/v3"},
    "distribution_available_capacity_digest":{"$ref":"#/$defs/hex64"},
    "affected_period_id":{"type":"string","minLength":1},
    "distribution_currency":{"type":"string","minLength":1},
    "source_account_id":{"type":"string","minLength":1},
    "beneficiary_set_digest":{"$ref":"#/$defs/hex64"},
    "principal_total":{"$ref":"#/$defs/decimal"},
    "external_fee_budget":{"$ref":"#/$defs/decimal"},
    "total_authorized_outflow_ceiling":{"$ref":"#/$defs/decimal"},
    "requirement_registry_digest":{"$ref":"#/$defs/hex64"},
    "approver_policy_digest":{"$ref":"#/$defs/hex64"},
    "verified_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "handoff_policy":{"const":"FEE_AWARE_AVAILABLE_CAPACITY_V3_EXACT_BATCH"},
    "authority":{"const":"FINANCIAL_OS_EXECUTION_HANDOFF_GATE_V3"},
    "payment_authority":{"const":"METAPAY_ONLY"},
    "execution_authority":{"const":"NONE"},
    "ai_authority":{"const":"NONE"},
    "usage_policy":{"const":"SINGLE_EXACT_BATCH"},
    "fee_policy":{"const":"PAYER_BORNE_SEPARATE_FROM_PRINCIPAL_UP_TO_BUDGET"},
    "digest":{"$ref":"#/$defs/hex64"}
  },
  "$defs":{
    "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  }
}
