{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/liquidity.current-resources-v1.json","title":"SINERGY liquidity.current-resources/v1","type":"object","additionalProperties":false,"required":["schema","resource_id","financial_snapshot_digest","accounting_close_digest","snapshot_sequence","snapshot_ledger_digest","reporting_currency","as_of","liquidity_policy_digest","liquid_haircut_asset_ceiling","horizons","generated_at","authority","authorization_authority","execution_authority","digest"],"properties":{"schema":{"const":"liquidity.current-resources/v1"},"resource_id":{"type":"string","minLength":1},"financial_snapshot_digest":{"$ref":"#/$defs/hex64"},"accounting_close_digest":{"$ref":"#/$defs/hex64"},"snapshot_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"snapshot_ledger_digest":{"$ref":"#/$defs/hex64"},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"as_of":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},"liquidity_policy_digest":{"$ref":"#/$defs/hex64"},"liquid_haircut_asset_ceiling":{"$ref":"#/$defs/nonnegative_decimal"},"horizons":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["horizon_weeks","liquid_resources","measurement_evidence_digest"],"properties":{"horizon_weeks":{"enum":[1,4,8]},"liquid_resources":{"$ref":"#/$defs/nonnegative_decimal"},"measurement_evidence_digest":{"$ref":"#/$defs/hex64"}}}},"generated_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},"authority":{"const":"FINANCIAL_OS_CURRENT_LIQUIDITY_RESOURCES"},"authorization_authority":{"const":"NONE"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nonnegative_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}