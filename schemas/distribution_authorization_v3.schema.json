{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"distribution.authorization/v3",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","authorization_id","decision","decision_authority","distribution_plan_digest","distribution_available_capacity_schema","distribution_available_capacity_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","approved_principal_amount","approved_external_fee_budget","approved_total_outflow_ceiling","requirement_registry_digest","approver_policy_digest","decision_evidence_digest","decided_at","expires_at","handoff_policy","execution_authority","payment_authority","ai_authority","usage_policy","fee_policy","digest"],
  "properties":{
    "schema":{"const":"distribution.authorization/v3"},
    "authorization_id":{"type":"string","minLength":1},
    "decision":{"enum":["APPROVED","REJECTED"]},
    "decision_authority":{"enum":["HUMAN_COMMITTEE","MULTISIG_GOVERNANCE"]},
    "distribution_plan_digest":{"$ref":"#/$defs/hex64"},
    "distribution_available_capacity_schema":{"const":"distribution.available-capacity/v3"},
    "distribution_available_capacity_digest":{"$ref":"#/$defs/hex64"},
    "affected_period_id":{"type":"string","minLength":1},
    "distribution_currency":{"type":"string","minLength":1},
    "source_account_id":{"type":"string","minLength":1},
    "beneficiary_set_digest":{"$ref":"#/$defs/hex64"},
    "approved_principal_amount":{"$ref":"#/$defs/decimal"},
    "approved_external_fee_budget":{"$ref":"#/$defs/decimal"},
    "approved_total_outflow_ceiling":{"$ref":"#/$defs/decimal"},
    "requirement_registry_digest":{"$ref":"#/$defs/hex64"},
    "approver_policy_digest":{"$ref":"#/$defs/hex64"},
    "decision_evidence_digest":{"$ref":"#/$defs/hex64"},
    "decided_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "handoff_policy":{"const":"FEE_AWARE_AVAILABLE_CAPACITY_V3_EXACT_BATCH"},
    "execution_authority":{"const":"SEPARATE_METAPAY_FEE_AWARE_BATCH_HANDOFF_V3"},
    "payment_authority":{"const":"METAPAY_ONLY_AFTER_EXECUTION_TICKET_V3"},
    "ai_authority":{"const":"NONE"},
    "usage_policy":{"const":"SINGLE_EXACT_BATCH"},
    "fee_policy":{"const":"PAYER_BORNE_SEPARATE_FROM_PRINCIPAL_UP_TO_BUDGET"},
    "digest":{"$ref":"#/$defs/hex64"}
  },
  "$defs":{
    "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  }
}
