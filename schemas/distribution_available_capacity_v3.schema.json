{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distribution.available-capacity/v3",
  "title": "DistributionAvailableCapacity v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","capacity_id","affected_period_id","base_distribution_capacity_replay_digest",
    "distribution_budget_state_schema","distribution_budget_state_digest","current_financial_snapshot_digest",
    "current_accounting_close_digest","current_liquidity_resources_digest","liquidity_policy_digest",
    "maturity_snapshot_digests","maturity_translation_digests","reporting_currency","current_snapshot_sequence",
    "current_snapshot_ledger_digest","gross_period_profit_budget","post_close_settlement_fee_expenses",
    "fee_adjusted_period_profit_budget","canonical_distribution_outflows","canonical_distribution_reversals",
    "net_consumed_distribution_budget","remaining_period_profit_budget","current_hard_nav",
    "current_required_hard_nav_buffer","current_solvency_headroom","current_liquidity_distribution_capacity",
    "final_available_capacity","horizon_headrooms","blockers","status","generated_at","authority",
    "authorization_authority","payment_authority","execution_authority","ai_authority","digest"
  ],
  "properties": {
    "schema": {"const": "distribution.available-capacity/v3"},
    "capacity_id": {"type": "string", "minLength": 1},
    "affected_period_id": {"type": "string", "minLength": 1},
    "base_distribution_capacity_replay_digest": {"$ref": "#/$defs/hex64"},
    "distribution_budget_state_schema": {"const": "distribution.budget-state/v2"},
    "distribution_budget_state_digest": {"$ref": "#/$defs/hex64"},
    "current_financial_snapshot_digest": {"$ref": "#/$defs/hex64"},
    "current_accounting_close_digest": {"$ref": "#/$defs/hex64"},
    "current_liquidity_resources_digest": {"$ref": "#/$defs/hex64"},
    "liquidity_policy_digest": {"$ref": "#/$defs/hex64"},
    "maturity_snapshot_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hex64"}},
    "maturity_translation_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hex64"}},
    "reporting_currency": {"type": "string", "minLength": 1},
    "current_snapshot_sequence": {"type": "integer", "minimum": 1},
    "current_snapshot_ledger_digest": {"$ref": "#/$defs/hex64"},
    "gross_period_profit_budget": {"$ref": "#/$defs/decimal"},
    "post_close_settlement_fee_expenses": {"$ref": "#/$defs/decimal"},
    "fee_adjusted_period_profit_budget": {"$ref": "#/$defs/decimal"},
    "canonical_distribution_outflows": {"$ref": "#/$defs/decimal"},
    "canonical_distribution_reversals": {"$ref": "#/$defs/decimal"},
    "net_consumed_distribution_budget": {"$ref": "#/$defs/decimal"},
    "remaining_period_profit_budget": {"$ref": "#/$defs/decimal"},
    "current_hard_nav": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "current_required_hard_nav_buffer": {"$ref": "#/$defs/decimal"},
    "current_solvency_headroom": {"$ref": "#/$defs/decimal"},
    "current_liquidity_distribution_capacity": {"$ref": "#/$defs/decimal"},
    "final_available_capacity": {"$ref": "#/$defs/decimal"},
    "horizon_headrooms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["CAPACITY_AVAILABLE", "NO_ACTION"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "FINANCIAL_OS_DISTRIBUTION_AVAILABLE_CAPACITY_V3"},
    "authorization_authority": {"const": "NONE"},
    "payment_authority": {"const": "NONE"},
    "execution_authority": {"const": "NONE"},
    "ai_authority": {"const": "NONE"},
    "digest": {"$ref": "#/$defs/hex64"}
  },
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  }
}
