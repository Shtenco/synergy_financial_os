{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.local/schemas/accounting.statement-replay-v1.json",
  "title":"SINERGY accounting.statement-replay/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","replay_id","affected_period_id","original_period_close_digest","original_accounting_close_digest","original_financial_snapshot_digest","opening_period_close_digest","opening_accounting_close_digest","account_registry_artifact_digest","account_registry_digest","valuation_policy_artifact_digest","valuation_policy_digest","restated_period_view_digest","overlay_digests","excluded_reporting_entry_digests","opening_sequence","closing_sequence","original_event_count","retained_event_count","excluded_event_count","replayed_ledger_digest","replayed_last_entry_digest","hard_external_assets","liquid_haircut_assets","economic_haircut_assets","external_liabilities","hard_nav","liquid_nav","economic_nav","realized_external_revenue","realized_external_pnl","liquidity_metrics","distribution_metrics","generated_at","authority","ledger_mutation_authority","execution_authority","digest"],
  "properties":{
    "schema":{"const":"accounting.statement-replay/v1"},
    "replay_id":{"type":"string","minLength":1},
    "affected_period_id":{"type":"string","minLength":1},
    "original_period_close_digest":{"$ref":"#/$defs/hex64"},
    "original_accounting_close_digest":{"$ref":"#/$defs/hex64"},
    "original_financial_snapshot_digest":{"$ref":"#/$defs/hex64"},
    "opening_period_close_digest":{"anyOf":[{"$ref":"#/$defs/hex64"},{"type":"null"}]},
    "opening_accounting_close_digest":{"anyOf":[{"$ref":"#/$defs/hex64"},{"type":"null"}]},
    "account_registry_artifact_digest":{"$ref":"#/$defs/hex64"},
    "account_registry_digest":{"$ref":"#/$defs/hex64"},
    "valuation_policy_artifact_digest":{"$ref":"#/$defs/hex64"},
    "valuation_policy_digest":{"$ref":"#/$defs/hex64"},
    "restated_period_view_digest":{"$ref":"#/$defs/hex64"},
    "overlay_digests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/hex64"}},
    "excluded_reporting_entry_digests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/hex64"}},
    "opening_sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "closing_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "original_event_count":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "retained_event_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "excluded_event_count":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "replayed_ledger_digest":{"$ref":"#/$defs/hex64"},
    "replayed_last_entry_digest":{"$ref":"#/$defs/hex64"},
    "hard_external_assets":{"$ref":"#/$defs/nonnegative_decimal"},
    "liquid_haircut_assets":{"$ref":"#/$defs/nonnegative_decimal"},
    "economic_haircut_assets":{"$ref":"#/$defs/nonnegative_decimal"},
    "external_liabilities":{"$ref":"#/$defs/nonnegative_decimal"},
    "hard_nav":{"$ref":"#/$defs/signed_decimal"},
    "liquid_nav":{"$ref":"#/$defs/signed_decimal"},
    "economic_nav":{"$ref":"#/$defs/signed_decimal"},
    "realized_external_revenue":{"$ref":"#/$defs/signed_decimal"},
    "realized_external_pnl":{"$ref":"#/$defs/signed_decimal"},
    "liquidity_metrics":{"const":"NOT_PERFORMED"},
    "distribution_metrics":{"const":"NOT_PERFORMED"},
    "generated_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},
    "authority":{"const":"FINANCIAL_OS_REPLAY_DERIVATION"},
    "ledger_mutation_authority":{"const":"NONE"},
    "execution_authority":{"const":"NONE"},
    "digest":{"$ref":"#/$defs/hex64"}
  },
  "$defs":{
    "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nonnegative_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "signed_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*(\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]|-[1-9][0-9]*(\\.[0-9]*[1-9])?|-0\\.[0-9]*[1-9])$"}
  }
}
