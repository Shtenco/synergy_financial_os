{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/maturity.translation-v1.json","type":"object","additionalProperties":false,"required":["schema","maturity_snapshot_digest","source_currency","reporting_currency","reporting_units_per_source_unit","as_of","translation_evidence_digest","generated_at","authority","accounting_authority","execution_authority","digest"],"properties":{"schema":{"const":"maturity.translation/v1"},"maturity_snapshot_digest":{"$ref":"#/$defs/hex64"},"source_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"reporting_units_per_source_unit":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},"as_of":{"type":"string"},"translation_evidence_digest":{"anyOf":[{"$ref":"#/$defs/hex64"},{"type":"null"}]},"generated_at":{"type":"string"},"authority":{"const":"FINANCIAL_OS_MATURITY_TRANSLATION"},"accounting_authority":{"const":"REFERENCE_ONLY"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}