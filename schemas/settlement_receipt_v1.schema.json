{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/settlement.receipt/v1",
  "title": "SINERGY SettlementReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settlement_id",
    "intent_id",
    "providers",
    "source_asset",
    "source_amount",
    "target_asset",
    "target_amount",
    "fees",
    "status",
    "finality_time",
    "external_evidence_classes",
    "external_references",
    "reconciled"
  ],
  "properties": {
    "schema": {"const": "settlement.receipt/v1"},
    "settlement_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_asset": {"type": "string", "minLength": 1, "maxLength": 32},
    "source_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "target_asset": {"type": "string", "minLength": 1, "maxLength": 32},
    "target_amount": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "amount", "kind"],
        "properties": {
          "asset": {"type": "string", "minLength": 1, "maxLength": 32},
          "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "kind": {"type": "string", "minLength": 1},
          "provider_ref": {"type": ["string", "null"]}
        }
      }
    },
    "status": {"enum": ["PENDING", "SETTLED", "FAILED", "REVERSED"]},
    "finality_time": {"type": ["string", "null"], "format": "date-time"},
    "external_evidence_classes": {
      "type": "array",
      "items": {
        "enum": ["BANK", "PSP", "CEX_FILL", "DEX_RECEIPT", "BLOCKCHAIN_FINALITY", "CBDC", "MERCHANT", "OTHER"]
      },
      "uniqueItems": true
    },
    "external_references": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "reconciled": {"type": "boolean"},
    "route_id": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
