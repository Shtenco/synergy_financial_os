{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/settlement.receipt/v1",
  "title": "SINERGY SettlementReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settlement_id",
    "intent_id",
    "provider_id",
    "asset",
    "gross_amount",
    "net_amount",
    "fee_amount",
    "status",
    "finality_time",
    "external_evidence_class"
  ],
  "properties": {
    "schema": {"const": "settlement.receipt/v1"},
    "settlement_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "gross_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "net_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "fee_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "status": {"enum": ["PENDING", "SETTLED", "FAILED", "REVERSED"]},
    "finality_time": {"type": ["string", "null"], "format": "date-time"},
    "external_evidence_class": {
      "enum": ["BANK", "PSP", "CEX_FILL", "DEX_RECEIPT", "BLOCKCHAIN_FINALITY", "CBDC", "MERCHANT", "OTHER"]
    },
    "external_reference": {"type": ["string", "null"]},
    "evidence_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "reconciled": {"type": "boolean", "default": false},
    "metadata": {"type": "object"}
  }
}
