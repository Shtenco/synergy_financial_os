{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinergy.system/schemas/ledger.inclusion-proof/v1",
  "title":"SINERGY LedgerInclusionProof v1","type":"object","additionalProperties":false,
  "$defs":{"hex64":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"safe":{"type":"integer","minimum":0,"maximum":9007199254740991}},
  "required":["schema","close_digest","ledger_root","event_digest","event_id","event_sequence","leaf_index","event_count","siblings","authority","execution_authority","digest"],
  "properties":{
    "schema":{"const":"ledger.inclusion-proof/v1"},"close_digest":{"$ref":"#/$defs/hex64"},"ledger_root":{"$ref":"#/$defs/hex64"},"event_digest":{"$ref":"#/$defs/hex64"},"event_id":{"type":"string","minLength":1},"event_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"leaf_index":{"$ref":"#/$defs/safe"},"event_count":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "siblings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["side","digest"],"properties":{"side":{"enum":["LEFT","RIGHT"]},"digest":{"$ref":"#/$defs/hex64"}}}},
    "authority":{"const":"PROVENANCE_ONLY"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}
  }
}
