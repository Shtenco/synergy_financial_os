{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/financial.snapshot/v1",
  "title": "SINERGY FinancialSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "as_of",
    "accounting_perimeter",
    "reporting_currency",
    "hard_nav",
    "liquid_nav",
    "economic_nav",
    "hard_external_assets",
    "external_liabilities",
    "net_new_capital_since_previous",
    "realized_external_revenue_since_previous",
    "distributable_profit",
    "policy_mode",
    "invariant_failures",
    "ledger_digest"
  ],
  "properties": {
    "schema": {"const": "financial.snapshot/v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "as_of": {"type": "string", "format": "date-time"},
    "accounting_perimeter": {"type": "string", "minLength": 1},
    "reporting_currency": {"type": "string", "minLength": 3, "maxLength": 16},
    "hard_nav": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "liquid_nav": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "economic_nav": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "hard_external_assets": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "external_liabilities": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "net_new_capital_since_previous": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "realized_external_revenue_since_previous": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "distributable_profit": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "policy_mode": {"enum": ["GROWTH", "NORMAL", "DEFENSE", "EMERGENCY", "NO_ACTION"]},
    "invariant_failures": {"type": "array", "items": {"type": "string"}},
    "ledger_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "previous_snapshot_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "signature": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
