{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.commitment-state-v1.json","title":"SINERGY distribution.commitment-state/v1","type":"object","additionalProperties":false,"required":["schema","state_id","state_version","previous_state_digest","reporting_currency","current_available_capacity_digest","current_snapshot_digest","current_snapshot_ledger_digest","current_snapshot_ledger_sequence","current_available_capacity","outstanding_commitments","remaining_authorizable_capacity","reservation_latest_digests","blockers","status","generated_at","authority","accounting_authority","authorization_authority","payment_authority","execution_authority","digest"],"properties":{"schema":{"const":"distribution.commitment-state/v1"},"state_id":{"type":"string","minLength":1},"state_version":{"type":"integer","minimum":1,"maximum":9007199254740991},"previous_state_digest":{"anyOf":[{"$ref":"#/$defs/hex64"},{"type":"null"}]},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"current_available_capacity_digest":{"$ref":"#/$defs/hex64"},"current_snapshot_digest":{"$ref":"#/$defs/hex64"},"current_snapshot_ledger_digest":{"$ref":"#/$defs/hex64"},"current_snapshot_ledger_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"current_available_capacity":{"$ref":"#/$defs/nonnegative_decimal"},"outstanding_commitments":{"$ref":"#/$defs/nonnegative_decimal"},"remaining_authorizable_capacity":{"$ref":"#/$defs/nonnegative_decimal"},"reservation_latest_digests":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hex64"}},"blockers":{"type":"array","uniqueItems":true,"items":{"enum":["CURRENT_AVAILABLE_CAPACITY_NO_ACTION","OUTSTANDING_COMMITMENTS_EXCEED_CURRENT_CAPACITY"]}},"status":{"enum":["AUTHORIZATION_CAPACITY_AVAILABLE","NO_ACTION"]},"generated_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},"authority":{"const":"FINANCIAL_OS_DISTRIBUTION_COMMITMENT_STATE"},"accounting_authority":{"const":"COMMITMENT_ONLY"},"authorization_authority":{"const":"REFERENCE_ONLY"},"payment_authority":{"const":"NONE"},"execution_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nonnegative_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}