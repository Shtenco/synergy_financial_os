{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.execution-ticket-v2.json","type":"object","additionalProperties":false,"required":["schema","ticket_id","distribution_authorization_digest","distribution_plan_digest","distribution_available_capacity_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","principal_total","external_fee_budget","total_authorized_outflow_ceiling","requirement_registry_digest","approver_policy_digest","verified_at","expires_at","authority","payment_authority","execution_authority","ai_authority","usage_policy","fee_policy","digest"],"properties":{"schema":{"const":"distribution.execution-ticket/v2"},"ticket_id":{"type":"string","minLength":1},"distribution_authorization_digest":{"$ref":"#/$defs/hex64"},"distribution_plan_digest":{"$ref":"#/$defs/hex64"},"distribution_available_capacity_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"distribution_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"source_account_id":{"type":"string","minLength":1},"beneficiary_set_digest":{"$ref":"#/$defs/hex64"},"principal_total":{"$ref":"#/$defs/positive_decimal"},"external_fee_budget":{"$ref":"#/$defs/nonnegative_decimal"},"total_authorized_outflow_ceiling":{"$ref":"#/$defs/positive_decimal"},"requirement_registry_digest":{"$ref":"#/$defs/hex64"},"approver_policy_digest":{"$ref":"#/$defs/hex64"},"verified_at":{"type":"string"},"expires_at":{"type":"string"},"authority":{"const":"FINANCIAL_OS_EXECUTION_HANDOFF_GATE_V2"},"payment_authority":{"const":"METAPAY_ONLY"},"execution_authority":{"const":"NONE"},"ai_authority":{"const":"NONE"},"usage_policy":{"const":"SINGLE_EXACT_BATCH"},"fee_policy":{"const":"PAYER_BORNE_SEPARATE_FROM_PRINCIPAL_UP_TO_BUDGET"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"positive_decimal":{"type":"string","pattern":"^([1-9][0-9]*)