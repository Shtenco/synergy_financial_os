{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.accounting-decision-v1.json","type":"object","additionalProperties":false,"required":["schema","decision_id","distribution_plan_digest","distribution_authorization_digest","distribution_execution_ticket_digest","distribution_attempt_digest","distribution_utilization_digest","settled_receipt_set_digest","affected_period_id","operational_source_account_id","reporting_cash_account_id","distribution_equity_account_id","source_account_mapping_evidence_digest","reporting_currency","settled_total_amount","status","blockers","decided_at","accounting_flow_type","economic_class","pnl_treatment","ledger_posting_authority","execution_authority","ai_authority","digest"],"properties":{"schema":{"const":"distribution.accounting-decision/v1"},"decision_id":{"type":"string","minLength":1},"distribution_plan_digest":{"$ref":"#/$defs/hex64"},"distribution_authorization_digest":{"$ref":"#/$defs/hex64"},"distribution_execution_ticket_digest":{"$ref":"#/$defs/hex64"},"distribution_attempt_digest":{"$ref":"#/$defs/hex64"},"distribution_utilization_digest":{"$ref":"#/$defs/hex64"},"settled_receipt_set_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"operational_source_account_id":{"type":"string","minLength":1},"reporting_cash_account_id":{"type":"string","minLength":1},"distribution_equity_account_id":{"type":"string","minLength":1},"source_account_mapping_evidence_digest":{"$ref":"#/$defs/hex64"},"reporting_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"settled_total_amount":{"$ref":"#/$defs/nonnegative_decimal"},"status":{"enum":["POSTABLE","NO_ACTION"]},"blockers":{"type":"array","uniqueItems":true,"items":{"enum":["NO_SETTLED_DISTRIBUTION","INSUFFICIENT_REPORTED_CASH_BALANCE","INSUFFICIENT_DISTRIBUTION_EQUITY_BALANCE"]}},"decided_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},"accounting_flow_type":{"const":"EXTERNAL_CAPITAL"},"economic_class":{"const":"OWNER_DISTRIBUTION"},"pnl_treatment":{"const":"EXCLUDED_FROM_REALIZED_PNL"},"ledger_posting_authority":{"const":"SEPARATE_CANONICAL_POSTING"},"execution_authority":{"const":"NONE"},"ai_authority":{"const":"NONE"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nonnegative_decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}}}