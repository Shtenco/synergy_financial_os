{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.execution-ticket-v1.json","type":"object","additionalProperties":false,"required":["schema","ticket_id","distribution_authorization_digest","distribution_plan_digest","distribution_capacity_replay_digest","liquidity_replay_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","total_amount","requirement_registry_digest","approver_policy_digest","verified_at","expires_at","authority","payment_authority","execution_authority","ai_authority","usage_policy","digest"],"properties":{"schema":{"const":"distribution.execution-ticket/v1"},"ticket_id":{"type":"string","minLength":1},"distribution_authorization_digest":{"$ref":"#/$defs/hex64"},"distribution_plan_digest":{"$ref":"#/$defs/hex64"},"distribution_capacity_replay_digest":{"$ref":"#/$defs/hex64"},"liquidity_replay_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"distribution_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"source_account_id":{"type":"string","minLength":1},"beneficiary_set_digest":{"$ref":"#/$defs/hex64"},"total_amount":{"type":"string","pattern":"^([1-9][0-9]*)(\\.[0-9]*[1-9])?$|^0\\.[0-9]*[1-9]$"},"requirement_registry_digest":{"$ref":"#/$defs/hex64"},"approver_policy_digest":{"$ref":"#/$defs/hex64"},"verified_at":{"type":"string"},"expires_at":{"type":"string"},"authority":{"const":"FINANCIAL_OS_EXECUTION_HANDOFF_GATE"},"payment_authority":{"const":"METAPAY_ONLY"},"execution_authority":{"const":"NONE"},"ai_authority":{"const":"NONE"},"usage_policy":{"const":"SINGLE_EXACT_BATCH"},"digest":{"$ref":"#/$defs/hex64"}},"$defs":{"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}