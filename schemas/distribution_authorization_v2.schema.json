{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sinergy.local/schemas/distribution.authorization-v2.json","type":"object","additionalProperties":false,"required":["schema","authorization_id","decision","decision_authority","distribution_plan_digest","distribution_available_capacity_digest","affected_period_id","distribution_currency","source_account_id","beneficiary_set_digest","approved_principal_amount","approved_external_fee_budget","approved_total_outflow_ceiling","requirement_registry_digest","approver_policy_digest","decision_evidence_digest","decided_at","expires_at","execution_authority","payment_authority","ai_authority","usage_policy","fee_policy","digest"],"properties":{"schema":{"const":"distribution.authorization/v2"},"authorization_id":{"type":"string","minLength":1},"decision":{"enum":["APPROVED","REJECTED"]},"decision_authority":{"enum":["HUMAN_COMMITTEE","MULTISIG_GOVERNANCE"]},"distribution_plan_digest":{"$ref":"#/$defs/hex64"},"distribution_available_capacity_digest":{"$ref":"#/$defs/hex64"},"affected_period_id":{"type":"string","minLength":1},"distribution_currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},"source_account_id":{"type":"string","minLength":1},"beneficiary_set_digest":{"$ref":"#/$defs/hex64"},"approved_principal_amount":{"$ref":"#/$defs/nonnegative_decimal"},"approved_external_fee_budget":{"$ref":"#/$defs/nonnegative_decimal"},"approved_total_outflow_ceiling":{"$ref":"#/$defs/nonnegative_decimal"},"requirement_registry_digest":{"$ref":"#/$defs/hex64"},"approver_policy_digest":{"$ref":"#/$defs/hex64"},"decision_evidence_digest":{"$ref":"#/$defs/hex64"},"decided_at":{"type":"string"},"expires_at":{"type":"string"},"execution_authority":{"const":"SEPARATE_METAPAY_FEE_BUDGETED_BATCH_HANDOFF"},"payment_authority":{"const":"METAPAY_ONLY_AFTER_EXECUTION_TICKET"},"ai_authority":{"const":"NONE"},"usage_policy":{"const":"SINGLE_EXACT_BATCH"},"fee_policy":{"const":"PAYER_BORNE_SEPARATE_FROM_PRINCIPAL_UP_TO_BUDG